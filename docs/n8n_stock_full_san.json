        "postgres": {
          "id": "rijAXrGxz9zhfKOb",
          "name": "Postgres account"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "delete from public.jard_category_flags where branch = 'سان ستيفانو';\n\ninsert into public.jard_category_flags (branch, category, itm_code)\nselect distinct 'سان ستيفانو', js.category, st.itm_code\nfrom public.stock_san st\ncross join public.jard_settings js\nwhere st.sto_qty_big::numeric > 0\n  and (\n    (js.keywords_ar is not null and array_length(js.keywords_ar, 1) > 0\n     and exists (select 1 from unnest(js.keywords_ar) as kw\n                 where translate(lower(st.itm_name_ar), 'إأآاىةث', 'اااايهت')\n                       like '%' || translate(lower(kw), 'إأآاىةث', 'اااايهت') || '%'))\n    or\n    (js.keywords_en is not null and array_length(js.keywords_en, 1) > 0\n     and exists (select 1 from unnest(js.keywords_en) as kw\n                 where lower(st.itm_name_en) like '%' || lower(kw) || '%'))\n    or\n    (js.category = 'غوالى' and js.min_price is not null\n     and st.itm_sell_price_big::numeric > js.min_price::numeric)\n  );",
        "options": {}
      },
      "id": "a1b25ee9-5075-4e87-8737-923896ab3e2f"
    }
