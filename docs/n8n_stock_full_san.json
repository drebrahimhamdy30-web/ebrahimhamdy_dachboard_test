      "parameters": {
        "jsCode": "// وضع التجربة: true = يقارن بس ومايكتبش. يتقلب false بعد يوم مقارنة ناجح.\nconst DRY = true;\nconst BRANCH = 'san';\nconst STORES = ['ابراهيم حمدي 2', 'سان'];\nconst COLS = [\"itm_code\",\"itnl_code\",\"itm_name_ar\",\"itm_name_en\",\"u_name_big\",\"sto_name\",\"sto_qty_big\",\"itm_sell_price_big\",\"itm_ismedicine\",\"Company_Name_Ar\",\"insert_date\",\"update_date\",\"last_trans_date\",\"u_name_small\",\"u_name_medium\",\"sto_qty_small\",\"sto_qty_medium\",\"itm_sell_price_small\",\"itm_sell_price_medium\",\"unit_big_medium_coeff\",\"unit_big_small_coeff\"];\n\nconst rows = [];\nlet total = 0;\nfor (const [node, med] of [['كوزمو', '0'], ['ادوية', '1']]) {\n  const j = $(node).first().json;\n  if (!j || !Array.isArray(j.Data) || String(j.Message).toLowerCase() === 'fail') {\n    throw new Error('eplus رد غلط في «' + node + '»: ' + ((j && (j.Error || j.Message)) || 'من غير Data'));\n  }\n  total += j.Data.length;\n  for (const r of j.Data) {\n    if (!STORES.includes(r.sto_name)) continue;\n    rows.push(COLS.map(c => (c === 'itm_ismedicine' && (r[c] === undefined || r[c] === null)) ? med : (r[c] ?? null)));\n  }\n}\nif (!rows.length) throw new Error('مفيش ولا صنف لمخازن ' + STORES.join(' / ') + ' من ' + total + ' صف');\nreturn [{ json: { branch: BRANCH, dry: DRY, cols: COLS, rows: JSON.stringify(rows), n: rows.length, total } }];"
      },
      "id": "7053e73b-399f-4793-ac4f-275593383ba9"
    },
