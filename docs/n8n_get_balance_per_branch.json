    {
      "parameters": {
        "jsCode": "// ═══ تجهيز الطلب ═══\n// بيتحقق من الكود والفرع، وبيحوّل اسم الفرع لاسم المخزن في eplus.\n// السويتش اللي بعده بيوجّه كل فرع لسيرفره.\n\nconst q      = $('Webhook').first().json.query || {};\nconst code   = String(q.code   ?? '').trim();\nconst branch = String(q.branch ?? '').trim();\n\n// نفس aliases في جدول branches — أي فرع جديد يتضاف هنا وفي السويتش\nconst STORE = {\n  'المعمورة':    'الصيدلية',\n  'سان ستيفانو': 'ابراهيم حمدي 2',\n  'سيدى بشر':    'ابراهيم حمدي 3',\n  'سيدي بشر':    'ابراهيم حمدي 3'\n};\n\n// ⚠️ قبل كده أي فرع غلط أو ناقص كان بيرجّع balance:0 من غير خطأ،\n//    فالشاشة تعرض صفر كأنه رصيد حقيقي وموظف الجرد يسجّل فرق وهمي.\nconst fail = (error, extra) => [{ json: Object.assign(\n  { found: false, in_branch: false, balance: 0, itm_name_ar: '', error },\n  extra || {}\n) }];\n\nif (!code)   return fail('الكود ناقص');\nif (!branch) return fail('الفرع ناقص — الشاشة مابعتتش فرع');\nif (!STORE[branch]) return fail('فرع غير معروف: ' + branch, { known: Object.keys(STORE) });\n\n// store = مفتاح التوجيه في السويتش\nreturn [{ json: { code, branch, store: STORE[branch] } }];"
      },
