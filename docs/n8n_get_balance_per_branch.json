    {
      "parameters": {
        "jsCode": "// ═══ تجميع الرصيد ═══\n// الرد دلوقتي جاي من سيرفر الفرع نفسه، مش من سيرفر المعمورة.\nconst prep = $('تجهيز الطلب').first().json;\nconst res  = $input.first().json;\n\nconst data = Array.isArray(res && res.Data) ? res.Data : [];\nif (!data.length && !(res && res.Data)) {\n  return [{ json: { found: false, in_branch: false, balance: 0, itm_name_ar: '',\n                    error: 'رد غير مفهوم من سيرفر ' + prep.branch } }];\n}\n\n// المطابقة على الكود أو الباركود الداخلي\nconst same = data.filter(i =>\n  String(i.itm_code  ?? '').trim() === prep.code ||\n  String(i.itnl_code ?? '').trim() === prep.code\n);\nconst mine = same.find(i => String(i.sto_name ?? '').trim() === prep.store);\nconst any  = same[0];\n\nreturn [{ json: {\n  // نفس الحقول القديمة — الشاشة ماتقعش قبل ما نحدّثها\n  found:       !!any,            // الكود موجود في eplus (مش شرط في فرعك)\n  itm_name_ar: (mine || any)?.itm_name_ar || '',\n  balance:     mine ? (Number(mine.sto_qty_big) || 0) : 0,\n  in_branch:   !!mine,           // ← الإشارة الصح: الصنف في مخزون فرعك\n\n  // تشخيص\n  branch:       prep.branch,\n  store:        prep.store,\n  stores_found: [...new Set(same.map(i => String(i.sto_name ?? '').trim()).filter(Boolean))]\n} }];"
      },
